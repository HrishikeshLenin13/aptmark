+        with db:
+            for skill,family,base,blueprint,generator in catalog:
+                for variant in range(per_family):
+                    seed=base+variant
+                    q=wrap(generator(family,seed),skill,family,seed)
+                    errors=validate(q)
+                    if errors: raise ValueError(f'{family}/{variant}: {errors}')
+                    existing=db.execute('SELECT data FROM candidates WHERE id=?',(q['id'],)).fetchone()
+                    if existing:
+                        if json.loads(existing[0])['contentHash']!=q['contentHash']:
+                            raise ValueError('Existing authored variant changed; version it explicitly: '+q['id'])
+                        continue
+                    # Unlike INSERT OR IGNORE, collisions abort the batch rather
+                    # than silently dropping a promised authored variant.
+                    db.execute('INSERT INTO candidates VALUES (?,?,?,?,?)',
+                        (q['id'],skill,q['problemHash'],family,json.dumps(q,ensure_ascii=False)))
+                    inserted+=1
+                have=db.execute('SELECT count(*) FROM candidates WHERE family=?',(family,)).fetchone()[0]
